#!/sbin/sh
# Magisk / KernelSU / APatch 模块安装入口。
# 改编自 VirtuMic systemless-overlay-module（MIT，Copyright (c) 2026 IndiTheo and IndiDevs，见 NOTICE.md）。
umask 022

OUTFD=$2
ZIPFILE=$3

# Fallback OUTFD detection for sideload quirks
if [ -z "$OUTFD" ] || ! [ -e "/proc/self/fd/$OUTFD" ]; then
  OUTFD=$(ps | grep -v grep | grep -oE 'status_fd=[0-9]+' | cut -d= -f2 | head -n1)
fi

ui_print() {
  if [ -n "$OUTFD" ] && [ -e "/proc/self/fd/$OUTFD" ]; then
    echo -e "ui_print $1\nui_print" >> "/proc/self/fd/$OUTFD"
  else
    echo "$1"
  fi
}

mount /data 2>/dev/null

if [ -f /data/adb/magisk/util_functions.sh ]; then
  . /data/adb/magisk/util_functions.sh
else
  ui_print "! Please install from Magisk, KernelSU, or APatch app"
  ui_print "! 请在 Magisk / KernelSU / APatch 管理器里安装本模块"
  exit 1
fi

if [ -z "$MAGISK_VER_CODE" ] || [ "$MAGISK_VER_CODE" -lt 20400 ]; then
  ui_print "! Requires Magisk 20.4+ (20400)"
  exit 1
fi

install_module
exit 0
